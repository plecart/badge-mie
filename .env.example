# Jeton fixe de l'API (32 octets aléatoires) : secret de la Function, jamais commité.
# Vit dans api/.env.local (ignoré par git), que lit `npm run deploy -w api` (voir api/neon.ts).
JETON_API=

# Adresse de l'API visée par l'app, posée au lancement de Metro (pas de fichier) :
# `EXPO_PUBLIC_API_URL="$QA_API" npm run start -w app -- --clear`. Absente ou vide : la Function
# de la branche Neon `main`, celle des vrais pointages (voir app/src/api-url.ts).
EXPO_PUBLIC_API_URL=
