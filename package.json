{
  "name": "badge-mie",
  "private": true,
  "type": "module",
  "workspaces": [
    "week",
    "api"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.3.0",
      "onFail": "error"
    }
